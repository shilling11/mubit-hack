# Mubit gateway (OpenAI-compatible). Use the base URL your console's Connect page shows.
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
MUBIT_API_KEY=mbt_your_key_here

# One fixed model for every review.*, report.* and rule.induce task (changing it splits Mubit tasks)
MUBIT_MODEL=gpt-6-luna
# Closed model for the Track 2 comparison
BASELINE_MODEL=gpt-6-sol

# Speech-to-text for call recordings (not an LLM call)
DEEPGRAM_API_KEY=your_deepgram_key

# Gmail account that sends escalations and client reports (needs 2-Step Verification + an app password)
GMAIL_USER=harbour.assurance.demo@gmail.com
GMAIL_APP_PASSWORD=your_app_password
