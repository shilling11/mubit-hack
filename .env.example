# Mubit gateway (OpenAI-compatible). Use the base URL your console's Connect page shows.
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
MUBIT_API_KEY=mbt_your_key_here

# Model the bid tasks run on (must be served by the starter credit or your provider key)
MUBIT_MODEL=gpt-6-luna
# Closed model for the Track 2 comparison
BASELINE_MODEL=gpt-6-sol

# Optional
# REDLINE_MAX_PARALLEL=4
# REDLINE_BASELINE_RECORD=metadata   # how base (v0) runs are recorded in Mubit
