# Mubit (every LLM call). Use the base URL your console's Connect page shows.
MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
MUBIT_API_KEY=mbt_your_key_here
# One fixed model for review.call and rule.induce (changing it splits Mubit tasks)
MUBIT_MODEL=gpt-6-luna
# Closed model for the Track 2 comparison
BASELINE_MODEL=gpt-6-sol

# Speech-to-text (not an LLM call, so it goes to Deepgram directly)
DEEPGRAM_API_KEY=


# Demo setup A (two phones on LiveKit) is configured in the web app, not here: put LIVEKIT_URL,
# LIVEKIT_API_KEY and LIVEKIT_API_SECRET in web/.env.local (and in the Vercel project's env vars)

# Optional
# REDRESS_AUDIT_RATE=0.05              # share of calls sent to analysts at random
# REDRESS_CRITICAL_CONFIDENCE=0.8      # below this, a critical item goes to an analyst
# REDRESS_SCORED_CONFIDENCE=0.6
# REDRESS_HELD_OUT_RECORD=metadata     # how base and held-out reviews are recorded in Mubit
